{
  "_metadata": {
    "major_version": 1,
    "minor_version": 1
  },
  "display_information": {
    "name": "Crawler",
    "description": "Crawler AI: workspace tools and a private DM chat with your assistant."
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "Crawler",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "channels:read",
        "groups:read",
        "channels:history",
        "groups:history",
        "chat:write",
        "reactions:write",
        "users:read",
        "files:read",
        "files:write",
        "channels:manage",
        "groups:write",
        "im:read",
        "im:history",
        "im:write"
      ],
      "user": [
        "search:read",
        "users.profile:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "message.im"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
