# syntax=docker/dockerfile:1
# Multi-stage backend image.
#   dev  — hot-reload uvicorn, source bind-mounted by docker-compose.yml
#   prod — non-root user, no reload, container healthcheck
# The dev compose builds `target: dev`; docker-compose.prod.yml builds
# `target: prod`.

FROM python:3.12-slim AS base

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Headless Chromium for the built-in web.screenshot tool ships IN the image:
# a shipped capability must not depend on someone running an installer
# inside a container later. A shared, world-readable browser path is
# required because the prod stage runs as a non-root user and Playwright's
# default cache lives under the installing user's home.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN python -m playwright install --with-deps chromium \
    && chmod -R a+rX /ms-playwright \
    && rm -rf /var/lib/apt/lists/*

# ── Development ──────────────────────────────────────────────────────
FROM base AS dev

COPY . .

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]

# ── Production ───────────────────────────────────────────────────────
FROM base AS prod

RUN useradd --create-home --uid 1000 appuser

COPY --chown=appuser:appuser . .

# The probe goes through TrustedHostMiddleware like any request, so it has
# to carry a Host the app accepts. In production ALLOWED_HOSTS lists the
# public domain (nginx forwards the client's Host), and a probe addressed
# as 127.0.0.1 is refused with 400: the backend never turns healthy and the
# frontend, which waits for it, never starts. Reading the list through the
# app's own settings keeps env vars and a mounted .env both in play. Inlined
# because the build context is ../backend, which cannot COPY from docker/.
COPY --chmod=0755 <<'EOF' /usr/local/bin/healthcheck
#!/usr/bin/env python3
import sys
import urllib.request

sys.path.insert(0, "/app")
from core.config import settings  # noqa: E402

hosts = [h for h in settings.ALLOWED_HOSTS if h != "*"]
host = hosts[0].replace("*", "healthcheck", 1) if hosts else "localhost"
request = urllib.request.Request(
    "http://127.0.0.1:8000/api/health", headers={"Host": host}
)
try:
    with urllib.request.urlopen(request, timeout=3) as response:
        sys.exit(0 if response.status == 200 else 1)
except Exception as exc:
    print(f"healthcheck failed (Host: {host}): {exc}", file=sys.stderr)
    sys.exit(1)
EOF

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD ["healthcheck"]

# Migrate before serving, so the schema is at head exactly once per deploy
# rather than being raced by however many workers start (init_db also
# upgrades, which covers a bare `uvicorn main:app` dev run; by the time the
# app starts here it is already a no-op).
#
# Graceful shutdown: stop accepting connections on SIGTERM but give
# in-flight agent turns (multi-round LLM + tool execution) time to finish
# and persist. Pairs with stop_grace_period: 60s in docker-compose.prod.yml.
CMD ["sh", "-c", "alembic upgrade head && exec uvicorn main:app --host 0.0.0.0 --port 8000 --timeout-graceful-shutdown 55"]
