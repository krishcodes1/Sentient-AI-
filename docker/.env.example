# PostgreSQL
POSTGRES_USER=sentientai
POSTGRES_PASSWORD=change-me-strong-random
POSTGRES_DB=sentientai

# Redis
REDIS_PASSWORD=change-me-strong-random

# Backend secrets — generate with: python3 -c "import secrets, base64, os; print('SECRET_KEY=' + secrets.token_urlsafe(48)); print('ENCRYPTION_KEY=' + base64.urlsafe_b64encode(os.urandom(32)).decode())"
SECRET_KEY=replace-me
ENCRYPTION_KEY=replace-me

# LLM provider — pick one
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# CORS — comma-separated origins for production
CORS_ORIGINS=https://sentientai.example.com

# Bind addresses (default: localhost-only; set to 0.0.0.0 to expose)
FRONTEND_BIND=127.0.0.1
BACKEND_BIND=127.0.0.1
